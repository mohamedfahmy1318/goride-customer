rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==================== HELPER FUNCTIONS ====================
    
    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Check if user is the owner of the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Check if user is a customer (has profile in users collection)
    function isCustomer() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    
    // Check if user is a driver (has profile in driver_users collection)
    function isDriver() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/driver_users/$(request.auth.uid));
    }
    
    // Check if user is either customer or driver
    function isValidUser() {
      return isCustomer() || isDriver();
    }
    
    // Get driver data (single read - optimized to avoid multiple get() calls)
    function getDriverData() {
      return get(/databases/$(database)/documents/driver_users/$(request.auth.uid)).data;
    }
    
    // Check if driver is verified AND active (admin approved + documents verified)
    // Optimized: uses single get() call via getDriverData()
    function isActiveDriver() {
      return isDriver() && 
        getDriverData().isApproved == true &&
        getDriverData().documentVerification == true;
    }
    
    // ==================== USERS COLLECTION (Customers) ====================
    
    match /users/{userId} {
      // Any authenticated user can read customer profiles (needed for chat, orders)
      allow read: if isAuthenticated();
      
      // User can only create their own profile with required fields
      allow create: if isOwner(userId) && 
        request.resource.data.keys().hasAll(['fullName', 'email', 'phoneNumber']) &&
        request.resource.data.id == userId;
      
      // User can only update their own profile
      // Cannot change: id (data integrity)
      allow update: if isOwner(userId) && 
        request.resource.data.id == resource.data.id;
      
      // No deletion allowed - data integrity for order history
      allow delete: if false;
      
      // Wallet transactions subcollection
      match /wallet_transaction/{transactionId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) || isDriver();
        allow update, delete: if false; // Immutable financial records
      }
    }
    
    // ==================== DRIVER USERS COLLECTION ====================
    
    match /driver_users/{userId} {
      // Any authenticated user can read driver profiles (needed for ride info)
      allow read: if isAuthenticated();
      
      // Driver can only create their own profile with required fields
      allow create: if isOwner(userId) && 
        request.resource.data.keys().hasAll(['fullName', 'email', 'phoneNumber']) &&
        request.resource.data.id == userId;
      
      // Driver can update own profile BUT cannot change admin-controlled fields
      allow update: if isOwner(userId) && 
        request.resource.data.id == resource.data.id &&
        request.resource.data.documentVerification == resource.data.documentVerification &&
        request.resource.data.isApproved == resource.data.isApproved;
      
      // No deletion
      allow delete: if false;
      
      // Wallet transactions subcollection
      match /wallet_transaction/{transactionId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) || isCustomer();
        allow update, delete: if false;
      }
    }
    
    // ==================== DRIVER LOCATION (Real-time tracking) ====================
    
    match /driver_location/{driverId} {
      // Customers can read driver location (for live tracking on map)
      allow read: if isAuthenticated();
      
      // Only the driver themselves can update their location
      allow create, update: if isOwner(driverId) && isDriver() &&
        request.resource.data.keys().hasAll(['latitude', 'longitude', 'rotation']);
      
      // Driver can delete when going offline
      allow delete: if isOwner(driverId);
    }
    
    // ==================== ORDERS COLLECTION (City Rides) ====================
    
    match /orders/{orderId} {
      // Customer can see their own orders
      // Driver can see orders assigned to them
      // Active drivers can see unassigned/pending orders (to accept new rides)
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.driverId == request.auth.uid ||
        (resource.data.driverId == null && isActiveDriver()) ||
        (resource.data.status == 'pending' && isActiveDriver())
      );
      
      // Only customers can create orders
      allow create: if isCustomer() && 
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'pending';
      
      // Update rules:
      allow update: if isAuthenticated() && (
        // Customer can update their own order (cancel, etc.)
        (resource.data.userId == request.auth.uid && 
         resource.data.status in ['pending', 'accepted', 'rideActive', 'rideHold', 'rideHoldAccepted']) ||
        
        // Active driver can accept unassigned orders
        (resource.data.driverId == null && isActiveDriver() && 
         request.resource.data.driverId == request.auth.uid) ||
        
        // Assigned driver can update order status
        (resource.data.driverId == request.auth.uid && isDriver())
      );
      
      // Never delete orders - keep for history/audit
      allow delete: if false;
      
      // Accepted drivers subcollection
      match /acceptedDriver/{driverId} {
        allow read: if isAuthenticated();
        allow create: if isDriver();
        allow update, delete: if false;
      }
    }
    
    // ==================== INTERCITY ORDERS ====================
    
    match /orders_intercity/{orderId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.driverId == request.auth.uid ||
        (resource.data.driverId == null && isActiveDriver()) ||
        (resource.data.status == 'pending' && isActiveDriver())
      );
      
      allow create: if isCustomer() && 
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'pending';
      
      allow update: if isAuthenticated() && (
        (resource.data.userId == request.auth.uid && 
         resource.data.status in ['pending', 'accepted', 'rideActive', 'rideHold', 'rideHoldAccepted']) ||
        (resource.data.driverId == null && isActiveDriver() && 
         request.resource.data.driverId == request.auth.uid) ||
        (resource.data.driverId == request.auth.uid && isDriver())
      );
      
      allow delete: if false;
      
      // Accepted drivers subcollection
      match /acceptedDriver/{driverId} {
        allow read: if isAuthenticated();
        allow create: if isDriver();
        allow update, delete: if false;
      }
    }
    
    // ==================== FREIGHT ORDERS ====================
    
    match /orders_freight/{orderId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.driverId == request.auth.uid ||
        (resource.data.driverId == null && isActiveDriver())
      );
      
      allow create: if isCustomer() && 
        request.resource.data.userId == request.auth.uid;
      
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.driverId == request.auth.uid ||
        (resource.data.driverId == null && isActiveDriver())
      );
      
      allow delete: if false;
    }
    
    // ==================== CHAT COLLECTION ====================
    
    match /chat/{chatId} {
      // Only chat participants can access
      allow read: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.driverId == request.auth.uid
      );
      
      // Participants can create chat
      allow create: if isAuthenticated() && (
        request.resource.data.customerId == request.auth.uid ||
        request.resource.data.driverId == request.auth.uid
      );
      
      // Participants can update (mark as read, typing status)
      allow update: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.driverId == request.auth.uid
      );
      
      allow delete: if false;
      
      // Messages subcollection (thread)
      match /thread/{messageId} {
        allow read: if isAuthenticated();
        
        // Only sender can create message
        allow create: if isAuthenticated() && 
          request.resource.data.senderId == request.auth.uid;
        
        // Messages are immutable
        allow update, delete: if false;
      }
      
      // Messages subcollection
      match /messages/{messageId} {
        allow read: if isAuthenticated();
        
        allow create: if isAuthenticated() && 
          request.resource.data.senderId == request.auth.uid;
        
        allow update, delete: if false;
      }
    }
    
    // ==================== REVIEWS ====================
    
    // Driver reviews (by customers)
    match /review_driver/{reviewId} {
      allow read: if isAuthenticated();
      
      // Only customers can review drivers
      allow create: if isCustomer() && 
        request.resource.data.customerId == request.auth.uid;
      
      // Reviews are permanent
      allow update, delete: if false;
    }
    
    // Customer reviews (by drivers)
    match /review_customer/{reviewId} {
      allow read: if isAuthenticated();
      
      // Only drivers can review customers
      allow create: if isDriver() && 
        request.resource.data.driverId == request.auth.uid;
      
      allow update, delete: if false;
    }
    
    // ==================== NOTIFICATIONS ====================
    
    match /notifications/{notificationId} {
      // User can only read their own notifications
      allow read: if isAuthenticated() && 
        resource.data.userId == request.auth.uid;
      
      // System/users can create notifications
      allow create: if isAuthenticated();
      
      // User can mark as read
      allow update: if isAuthenticated() && 
        resource.data.userId == request.auth.uid;
      
      allow delete: if false;
    }
    
    // ==================== WALLET TRANSACTIONS (Root level) ====================
    
    match /wallet_transaction/{transactionId} {
      // User can only read their own transactions
      allow read: if isAuthenticated() && 
        resource.data.userId == request.auth.uid;
      
      // Users can create transactions
      allow create: if isAuthenticated() && 
        request.resource.data.userId == request.auth.uid;
      
      // Financial records are immutable
      allow update, delete: if false;
    }
    
    // ==================== DRIVER DOCUMENTS ====================
    
    match /driver_document/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if false;
    }
    
    // Document definitions - authenticated read
    match /documents/{docId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }
    
    // ==================== BANK DETAILS ====================
    
    match /bank_details/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if false;
    }
    
    // ==================== WITHDRAWAL ====================
    
    match /withdrawal_history/{withdrawId} {
      allow read: if isAuthenticated() && 
        resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }
    
    // ==================== SUBSCRIPTION ====================
    
    match /subscription_plans/{planId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }
    
    match /subscription_history/{historyId} {
      allow read: if isAuthenticated() && 
        resource.data.user_id == request.auth.uid;
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }
    
    // ==================== REFERRAL ====================
    
    match /referral/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if false;
    }
    
    match /referral_history/{referralId} {
      allow read: if isAuthenticated() && (
        resource.data.referrerId == request.auth.uid ||
        resource.data.referredId == request.auth.uid
      );
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }
    
    // ==================== SCHEDULED RIDES ====================
    
    match /scheduled_rides/{rideId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.driverId == request.auth.uid
      );
      
      allow create: if isCustomer() && 
        request.resource.data.userId == request.auth.uid;
      
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.driverId == request.auth.uid
      );
      
      // Customer can cancel pending scheduled rides only
      allow delete: if isCustomer() && 
        resource.data.userId == request.auth.uid &&
        resource.data.status == 'pending';
    }
    
    // ==================== FAVORITE PLACES ====================
    
    match /favorite_locations/{locationId} {
      allow read: if isAuthenticated() && 
        resource.data.userId == request.auth.uid;
      
      allow create: if isAuthenticated() && 
        request.resource.data.userId == request.auth.uid;
      
      allow update, delete: if isAuthenticated() && 
        resource.data.userId == request.auth.uid;
    }
    
    // ==================== SUPPORT TICKETS ====================
    
    match /support_tickets/{ticketId} {
      allow read: if isAuthenticated() && 
        resource.data.userId == request.auth.uid;
      
      allow create: if isAuthenticated() && 
        request.resource.data.userId == request.auth.uid;
      
      allow update: if isAuthenticated() && 
        resource.data.userId == request.auth.uid;
      
      allow delete: if false;
    }
    
    // ==================== PUBLIC READ COLLECTIONS (Admin write only) ====================
    
    match /settings/{document} {
      allow read: if true;
      allow write: if false;
    }
    
    match /service/{serviceId} {
      allow read: if true;
      allow write: if false;
    }
    
    match /intercity_service/{serviceId} {
      allow read: if true;
      allow write: if false;
    }
    
    match /freight_vehicle/{vehicleId} {
      allow read: if true;
      allow write: if false;
    }
    
    match /vehicle_type/{vehicleId} {
      allow read: if true;
      allow write: if false;
    }
    
    match /zone/{zoneId} {
      allow read: if true;
      allow write: if false;
    }
    
    match /banner/{bannerId} {
      allow read: if true;
      allow write: if false;
    }
    
    match /tax/{taxId} {
      allow read: if true;
      allow write: if false;
    }
    
    match /currency/{currencyId} {
      allow read: if true;
      allow write: if false;
    }
    
    match /languages/{languageId} {
      allow read: if true;
      allow write: if false;
    }
    
    match /coupon/{couponId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }
    
    match /referral_settings/{referralId} {
      allow read: if true;
      allow write: if false;
    }
    
    match /on_boarding/{onboardingId} {
      allow read: if true;
      allow write: if false;
    }
    
    match /faq/{faqId} {
      allow read: if true;
      allow write: if false;
    }
    
    match /sos/{sosId} {
      allow read: if true;
      allow write: if false;
    }
    
    match /airports/{airportId} {
      allow read: if true;
      allow write: if false;
    }
    
    match /cms_pages/{pageId} {
      allow read: if true;
      allow write: if false;
    }
    
    match /vehicle_brand/{brandId} {
      allow read: if true;
      allow write: if false;
    }
    
    match /vehicle_model/{modelId} {
      allow read: if true;
      allow write: if false;
    }
    
    match /payment_methods/{methodId} {
      allow read: if true;
      allow write: if false;
    }
    
    match /cancellation_reasons/{reasonId} {
      allow read: if true;
      allow write: if false;
    }
    
    match /driver_rules/{ruleId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }
  }
}
